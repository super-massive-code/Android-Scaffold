# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Room, Retrofit, OkHttp, Hilt, and kotlinx.serialization each ship their own
# consumer keep rules inside their AARs/JARs, which R8 merges automatically.
# No extra rules are needed here for the direct, non-reflective usage in this
# scaffold (e.g. MealSummaryDto.serializer() resolved at compile time). Add
# rules here only if a library's docs call for it or a release build strips
# something a debug build didn't.